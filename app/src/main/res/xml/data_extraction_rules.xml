<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="."/>
        <!-- Keystore-encrypted secrets cannot be restored on another device; never back them up. -->
        <exclude domain="sharedpref" path="fp_credentials.xml"/>
        <exclude domain="file" path="migration-backup/"/>
        <!-- Downloaded fonts (14-24 MB each) are re-creatable; Auto Backup stops for good above 25 MB of app data. -->
        <exclude domain="file" path="fonts/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="."/>
        <exclude domain="sharedpref" path="fp_credentials.xml"/>
        <exclude domain="file" path="migration-backup/"/>
    </device-transfer>
</data-extraction-rules>
